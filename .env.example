PORT=3000
SMTP_HOST=smtp.fastmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@logixmotion.com
SMTP_PASS=your_app_password_here
SMTP_FROM_EMAIL=your_email@logixmotion.com
CONTACT_EMAIL=admin@logixmotion.com

# Anti-spam settings (contact form)
# Secret used to sign form tokens - set a long random string so tokens survive restarts.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FORM_SECRET=change_me_to_a_long_random_string
# Minimum time a human needs to fill the form before submitting (milliseconds)
FORM_MIN_FILL_MS=2500
# Per-IP rate limit: max messages per window
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=600000